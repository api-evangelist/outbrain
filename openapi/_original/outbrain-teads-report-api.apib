<tr><td>demand_id</td><td>Displays the id of the connection or the insertion accordingly</td></tr>
<tr><td>demand_name</td><td>Displays the name of the connection or the insertion accordingly</td></tr>
<tr><td>demand_category</td><td>Indicates the format mode of the connection or insertion</td></tr>
<tr><td>demand_start_mode</td><td>Indicates the start mode of the connection or insertion</td></tr>
<tr><td>demand_type</td><td>Indicates the buying type of the connection or insertion</td></tr>
<tr><td>demand_rule</td><td>Displays the rule of the connection or insertion accordingly</td></tr>
<tr><td>demand_rule_id</td><td>Displays the rule id of the connection or insertion accordingly</td></tr>
<tr><td>demand_rule_is_exelate</td><td>Indicates whether your connection or insertion has Exelate targeting</td></tr>
<tr><td>demand_rule_is_grapeshot</td><td>Indicates whether your connection or insertion has Grapeshot targeting</td></tr>
<tr><td>demand_rule_is_emetriq</td><td>Indicates whether your connection or insertion has Emetriq targeting</td></tr>
<tr><td>demand_rule_is_bluekai</td><td>Indicates whether your connection or insertion has Bluekai targeting</td></tr>
</table>

